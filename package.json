{
  "homepage": "https://huskywintersports.org",
  "name": "website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build/prerender.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "npm run test:unit && playwright test --project=desktop-chrome --project=mobile-chrome",
    "test:unit": "node --test tests/**/*.test.js",
    "test:all": "npm run test:unit && playwright test",
    "test:report": "playwright show-report",
    "sync": "node scripts/sync/sync-content.js",
    "audit:widows": "node scripts/audit/find-widows.js"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "node-html-parser": "^9.0.1",
    "vite": "^7.1.0"
  }
}
