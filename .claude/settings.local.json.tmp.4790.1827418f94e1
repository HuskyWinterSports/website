{
  "permissions": {
    "allow": [
      "Bash(npm ci *)",
      "Bash(npx vite *)",
      "Bash(npx playwright *)",
      "Bash(npx eslint *)",
      "Bash(npm test *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Read(//tmp/transport-verify/**)",
      "Read(//tmp/**)",
      "Bash(node *)",
      "Bash(xargs -r kill)",
      "Bash(gh pr *)",
      "Bash(git fetch *)",
      "Bash(git reset *)",
      "Bash(git pull *)",
      "Bash(git commit *)",
      "Bash(git push *)"
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  }
}
