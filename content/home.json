            {
              "bold": false,
              "italic": false,
              "href": null,
              "text": "From 5 years old to 105, our lessons are designed for all ages and ability levels. Whether you’re starting with pizza and french fries or looking for some extra instruction shredding double blacks, we have the lesson for you!"
            }
          ]
        },
        {
          "type": "heading",
          "level": 3,
          "spans": [
            {
              "bold": false,
              "italic": false,
              "href": null,
              "text": "Support UW Students"
            }
          ]
        },
        {
          "type": "paragraph",
          "spans": [
            {
              "bold": false,
              "italic": false,
              "href": null,
              "text": "Husky Winter Sports is a nonprofit dedicated to increasing accessibility to snow sports for students at the University of Washington. Your lesson fees help us cover instructor’s passes, equipment, and more. By purchasing a lesson, you support local student instructors while also getting the lowest price on the mountain!"
            }
          ]
        },
        {
          "type": "heading",
          "level": 3,
          "spans": [
            {
              "bold": false,
              "italic": false,
              "href": null,
              "text": "Safety Comes First"
            }
          ]
        },
        {
          "type": "paragraph",
          "spans": [
            {
              "bold": false,
              "italic": false,
              "href": null,
              "text": "Above all else, we value safety on the mountain. Our hiring process brings us responsible and enthusiastic instructors who are trained with PSIA/AASI guidelines to promote safety, fun, and learning on the slopes!"
            }
          ]
        }
      ]
